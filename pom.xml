<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <!-- Información básica del proyecto -->
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.i360ingenieria</groupId>
    <artifactId>intranetnas</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    
    <name>Intranet NAS</name>
    <description>Proyecto de intranet para NAS</description>
    
    <!-- Propiedades del proyecto -->
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        
        <!-- Configuración de SonarQube -->
        <sonar.projectKey>i360ingenieria_intranetnas</sonar.projectKey>
        <sonar.projectName>Intranet NAS</sonar.projectName>
        <sonar.organization>i360ingenieria</sonar.organization>
    </properties>
    
    <!-- Dependencias de tu proyecto -->
    <dependencies>
        <!-- Tus dependencias aquí -->
        <!-- Ejemplo: -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>3.2.0</version>
        </dependency>
    </dependencies>
    
    <!-- Construcción del proyecto -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Plugin de SonarQube -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>4.0.0.4121</version>
                </plugin>
                
                <!-- Otros plugins que puedas tener -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>